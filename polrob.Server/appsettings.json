{
  "ConnectionStrings": {
    "CosmosDb": ""
  },
  "CosmosDb": {
    "DatabaseId": "PolRobDB",
    "UsersContainerId": "Users",
    "GameRecordsContainerId": "GameRecords"
  },
  "GameNetwork": {
    "RoomCommandQueueCapacity": 4096,
    "UdpPacketsPerSecond": 30,
    "UdpBurstSize": 20,
    "MaxRooms": 500,
    "MaxTcpConnections": 2048,
    "TcpSendQueueCapacity": 64,
    "TcpSendQueueBytes": 262144,
    "TcpJoinTimeoutSeconds": 10,
    "TcpIdleTimeoutSeconds": 45,
    "TcpSendTimeoutSeconds": 5,
    "MaxPendingUdpSends": 1024,
    "GlobalUdpPacketsPerSecond": 20000
  },
  "LiveKit": {
    "_comment": "로컬 개발 값은 user-secrets에, 배포 값은 App Settings 또는 Key Vault에 설정합니다. API secret은 이 파일이나 클라이언트에 넣지 않습니다.",
    "Url": "",
    "ApiKey": "",
    "ApiSecret": "",
    "TokenLifetimeMinutes": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GameRecords": {
    "Directory": "data/game-record-outbox",
    "MaxRecords": 10000,
    "MaxBytes": 268435456,
    "MaxRecordBytes": 65536,
    "AdmissionThreshold": 0.8,
    "RetrySeconds": 5,
    "WriteTimeoutSeconds": 15
  },
  "Limits": {
    "HttpConcurrentRequests": 128,
    "HttpRequestsPerMinute": 600,
    "AuthRequestsPerMinute": 30,
    "MaxHubConnections": 2048
  },
  "Operations": {
    "ApiKey": "",
    "DrainSeconds": 20
  }
