<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">net10.0-android;net10.0-ios</TargetFrameworks>
		<!-- 타겟 플랫폼별로 런타임을 분리하여 Android 빌드 시 iOS 런타임이 섞여 들어가는 XA0035 에러를 방지합니다. -->
		<RuntimeIdentifiers Condition="$(TargetFramework.Contains('-android'))">android-arm64;android-x64;android-arm;android-x86</RuntimeIdentifiers>
		<RuntimeIdentifiers Condition="$(TargetFramework.Contains('-ios'))">ios-arm64;iossimulator-x64;iossimulator-arm64</RuntimeIdentifiers>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>polrob.Client</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>PolRob</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.polrob</ApplicationId>
		<!-- 실기기 개발 주소는 -p:PolRobPhysicalServerHost=... 로 덮어쓸 수 있습니다. -->
		<PolRobPhysicalServerHost Condition="'$(PolRobPhysicalServerHost)' == ''">192.168.0.83</PolRobPhysicalServerHost>
		<PolRobApiBaseUrl Condition="'$(PolRobApiBaseUrl)' == ''"></PolRobApiBaseUrl>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<ApplicationManifest Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and '$(Configuration)' == 'Debug'">Platforms/iOS/Info.Debug.plist</ApplicationManifest>
		<ApplicationManifest Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and '$(Configuration)' != 'Debug'">Platforms/iOS/Info.plist</ApplicationManifest>
		<AndroidManifestPlaceholders Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Debug'">usesCleartextTraffic=true</AndroidManifestPlaceholders>
		<AndroidManifestPlaceholders Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' != 'Debug'">usesCleartextTraffic=false</AndroidManifestPlaceholders>
		<EnableMauiSplashScreenProcessing Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">false</EnableMauiSplashScreenProcessing>

		<!-- Transparent-pixel bounds are generated at build time, never on the game UI thread. -->
		<AssetBoundsGeneratorProject>$(MSBuildProjectDirectory)/../tools/PolRob.AssetBounds/PolRob.AssetBounds.csproj</AssetBoundsGeneratorProject>
		<AssetBoundsGeneratedFile>$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/generated/GeneratedAssetBounds.g.cs</AssetBoundsGeneratedFile>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<!-- <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" /> -->
		<MauiIcon Include="Resources\AppIcon\polrobicon_new.png" Color="#BDBDBD" />


		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\android_splash_icon.png" Color="#000000" BaseSize="180,180" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Include="Resources\Raw\robber_in_jail2.png"
		           Link="Resources\Images\robber_in_jail2.png"
		           Resize="True"
		           BaseSize="48,48" />
		<!-- 로비에서는 46dp로 표시하므로 1024px 원본을 그대로 디코딩하지 않습니다. -->
		<MauiImage Update="Resources\Images\lobby_police_avatar.png" Resize="True" BaseSize="64,64" />
		<MauiImage Update="Resources\Images\lobby_robber_avatar.png" Resize="True" BaseSize="64,64" />
		<MauiImage Include="Resources\Splash\splashpolrob_new.png" Link="Resources\Images\splashpolrob_full.png" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<MauiAsset Remove="Resources\Raw\robber_in_jail2.png" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.5" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.2" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<BundleResource Include="Resources\Splash\splashpolrob_new.png" LogicalName="splashpolrob_native.png" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\polrob.Shared\polrob.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyMetadata Include="PolRobPhysicalServerHost" Value="$(PolRobPhysicalServerHost)" />
		<AssemblyMetadata Include="PolRobApiBaseUrl" Value="$(PolRobApiBaseUrl)" />
	</ItemGroup>

	<ItemGroup>
		<AssetBoundsInput Include="$(MSBuildProjectDirectory)/Resources/Raw/MapAssets/**/*.png" />
		<AssetBoundsInput Include="$(MSBuildProjectDirectory)/Resources/Raw/char_*.png" />
		<AssetBoundsGeneratorInput Include="$(AssetBoundsGeneratorProject)" />
		<AssetBoundsGeneratorInput Include="$(MSBuildProjectDirectory)/../tools/PolRob.AssetBounds/Program.cs" />
		<Compile Include="$(AssetBoundsGeneratedFile)" Visible="false" />
	</ItemGroup>

	<Target Name="GenerateAssetBounds"
			BeforeTargets="CoreCompile"
			Inputs="@(AssetBoundsInput);@(AssetBoundsGeneratorInput)"
			Outputs="$(AssetBoundsGeneratedFile)">
		<MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(AssetBoundsGeneratedFile)'))" />
		<Exec Command="dotnet run --project &quot;$(AssetBoundsGeneratorProject)&quot; --configuration $(Configuration) --no-launch-profile -- &quot;$(MSBuildProjectDirectory)/Resources/Raw&quot; &quot;$(AssetBoundsGeneratedFile)&quot;" />
	</Target>

	<!-- HybridWebView는 기본 파일이 없어도 컴파일되므로, 보이스 런타임 누락을 빌드에서 차단합니다. -->
	<Target Name="ValidateTeamVoiceAssets" BeforeTargets="PrepareForBuild">
		<Error Condition="!Exists('$(MSBuildProjectDirectory)/Resources/Raw/voice/index.html')"
		       Text="Team voice asset is missing: Resources/Raw/voice/index.html" />
		<Error Condition="!Exists('$(MSBuildProjectDirectory)/Resources/Raw/voice/voice-room.js')"
		       Text="Team voice asset is missing: Resources/Raw/voice/voice-room.js" />
	</Target>

	<!-- 배포 앱에서 로그인 세션과 보이스 JWT가 평문 HTTP로 이동하는 것을 차단합니다. -->
	<Target Name="ValidateReleaseServerTransport" BeforeTargets="PrepareForBuild"
			Condition="'$(Configuration)' != 'Debug'">
		<Error Condition="!$([System.String]::Copy('$(PolRobApiBaseUrl)').StartsWith('https://'))"
		       Text="Release builds require -p:PolRobApiBaseUrl=https://your-api-host/" />
	</Target>

</Project>
