<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:voice="clr-namespace:polrob.Client.Voice"
             x:Class="polrob.Client.GamePlay"
             x:Name="GamePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#555555">

    <Grid x:Name="Container">
        <!-- 런타임에서 SKGLView(기기) 또는 SKCanvasView(시뮬레이터) 를 추가합니다 -->

        <!-- LiveKit 오디오를 유지하는 보이지 않는 네이티브/WebRTC 브리지입니다. -->
        <HybridWebView x:Name="VoiceWebView"
                       HybridRoot="voice"
                       DefaultFile="index.html"
                       WidthRequest="1"
                       HeightRequest="1"
                       Opacity="0.01"
                       InputTransparent="True"
                       HorizontalOptions="Start"
                       VerticalOptions="End"/>

        <!-- 오류 문구 없이 팀원과 발화 상태만 보여주는 화면 고정 로스터입니다. -->
        <VerticalStackLayout Spacing="4"
                             Margin="0,0,14,32"
                             MaximumWidthRequest="220"
                             HorizontalOptions="End"
                             VerticalOptions="End"
                             InputTransparent="True"
                             BindableLayout.ItemsSource="{Binding VoiceMembers, Source={x:Reference GamePage}}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="voice:TeamVoiceMemberViewModel">
                    <Border BackgroundColor="#B30F172A"
                            Stroke="#805E6B7D"
                            StrokeThickness="1"
                            Padding="0"
                            HeightRequest="38"
                            StrokeShape="RoundRectangle 7">
                        <Grid ColumnDefinitions="38,*,Auto"
                                ColumnSpacing="9">
                            <Border BackgroundColor="{Binding SlotColor}"
                                    StrokeThickness="0"
                                    Margin="2"
                                    Padding="0"
                                    StrokeShape="RoundRectangle 5">
                                <Label Text="{Binding SlotNumber}"
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"/>
                            </Border>

                            <Label Grid.Column="1"
                                   Text="{Binding DisplayName}"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="13"
                                   LineBreakMode="TailTruncation"
                                   VerticalTextAlignment="Center"/>

                            <Label Grid.Column="2"
                                   Text="🔊"
                                   TextColor="#7DD3FC"
                                   FontSize="16"
                                   Margin="0,0,9,0"
                                   IsVisible="{Binding IsSpeaking}"
                                   VerticalTextAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <!-- 남은 시간은 문구 없이 숫자만 보여주는 중앙 HUD입니다. -->
        <Border BackgroundColor="#D9182029"
                Stroke="#8094A3B8"
                StrokeThickness="1"
                Padding="18,5"
                Margin="0,18,0,0"
                MinimumWidthRequest="92"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                InputTransparent="True"
                StrokeShape="RoundRectangle 14">
            <Label x:Name="TimerLabel"
                   Text="300"
                   TextColor="#FFF7E6"
                   FontAttributes="Bold"
                   FontSize="28"
                   CharacterSpacing="1.4"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"/>
        </Border>

        <!-- 감옥 아이콘과 현재/전체 도둑 수만 보여주는 우측 HUD입니다. -->
        <Border BackgroundColor="#D9182029"
                Stroke="#8094A3B8"
                StrokeThickness="1"
                Padding="6,4,11,4"
                Margin="0,18,14,0"
                HorizontalOptions="End"
                VerticalOptions="Start"
                InputTransparent="True"
                StrokeShape="RoundRectangle 14">
            <Grid ColumnDefinitions="34,Auto"
                    ColumnSpacing="7">
                <Image Source="robber_in_jail2.png"
                       WidthRequest="32"
                       HeightRequest="32"
                       Aspect="AspectFit"
                       VerticalOptions="Center"/>
                <Label x:Name="JailLabel"
                       Grid.Column="1"
                       Text="0/0"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="17"
                       CharacterSpacing="0.6"
                       VerticalTextAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 화면 중앙 메세지 (카운트다운 등) -->
        <Label x:Name="CenterMessageLabel"
               Text=""
               TextColor="White"
               FontAttributes="Bold"
               FontSize="64"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               InputTransparent="True"/>
    </Grid>

</ContentPage>
