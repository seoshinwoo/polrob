<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:voice="clr-namespace:polrob.Client.Voice"
             x:Class="polrob.Client.GamePlay"
             x:Name="GamePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#555555">

    <Grid x:Name="Container">
        <!-- 런타임에서 SKGLView(기기) 또는 SKCanvasView(시뮬레이터) 를 추가합니다 -->

        <!--
          LiveKit 오디오를 실행하는 보이지 않는 브리지입니다.
          IsVisible=False로 만들면 운영체제가 오디오를 중단할 수 있어 1x1 크기로 유지합니다.
        -->
        <HybridWebView x:Name="VoiceWebView"
                       HybridRoot="voice"
                       DefaultFile="index.html"
                       WidthRequest="1"
                       HeightRequest="1"
                       Opacity="0.01"
                       InputTransparent="True"
                       HorizontalOptions="Start"
                       VerticalOptions="End" />

        <!-- 같은 팀 목록 및 보이스 상태. 각 행을 누르면 해당 대상의 음소거가 토글됩니다. -->
        <Border BackgroundColor="#DC111827"
                Stroke="#667085"
                StrokeThickness="1"
                Padding="12,10"
                Margin="16,76,0,0"
                MaximumWidthRequest="250"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="팀 보이스"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="16" />
                    <Label Grid.Column="1"
                           Text="LIVE"
                           TextColor="#86EFAC"
                           FontAttributes="Bold"
                           FontSize="10"
                           VerticalTextAlignment="Center" />
                </Grid>

                <Label x:Name="VoiceStatusLabel"
                       Text="연결 준비 중..."
                       TextColor="#CBD5E1"
                       FontSize="11"
                       LineBreakMode="TailTruncation" />

                <BoxView HeightRequest="1" Color="#475569" />

                <VerticalStackLayout Spacing="4"
                                     BindableLayout.ItemsSource="{Binding VoiceMembers, Source={x:Reference GamePage}}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="voice:TeamVoiceMemberViewModel">
                            <Border BackgroundColor="#80233446"
                                    StrokeThickness="0"
                                    Padding="8,6"
                                    Opacity="{Binding RowOpacity}"
                                    StrokeShape="RoundRectangle 8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnVoiceMemberTapped"
                                                          CommandParameter="{Binding Identity}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="7">
                                    <Label Text="●"
                                           TextColor="#4ADE80"
                                           FontSize="12"
                                           IsVisible="{Binding IsSpeaking}"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                                        <Label Text="{Binding DisplayNameWithSelf}"
                                               TextColor="White"
                                               FontAttributes="Bold"
                                               FontSize="13"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding StatusText}"
                                               TextColor="#CBD5E1"
                                               FontSize="10"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2"
                                           Text="{Binding MuteGlyph}"
                                           FontSize="17"
                                           VerticalTextAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- UI 오버레이 예시 (게임 화면 위에 그려짐) -->
        <!-- 타이머 레이블 (중앙 상단) -->
        <Label x:Name="TimerLabel"
               Text="Timer : 300"
               TextColor="White"
               FontAttributes="Bold"
               FontSize="32"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               Margin="0, 20, 0, 0"
               InputTransparent="True"/>

        <!-- 감옥 현황 레이블 (우측 상단) -->
        <Label x:Name="JailLabel"
               Text="Jail : 0/0"
               TextColor="White"
               FontAttributes="Bold"
               FontSize="16"
               HorizontalOptions="End"
               VerticalOptions="Start"
               Margin="0, 20, 20, 0"
               InputTransparent="True"/>

        <!-- 화면 중앙 메세지 (카운트다운 등) -->
        <Label x:Name="CenterMessageLabel"
               Text=""
               TextColor="White"
               FontAttributes="Bold"
               FontSize="64"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               InputTransparent="True"/>
    </Grid>

</ContentPage>
