<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="polrob.Client.GamePlay"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#555555">

    <Grid x:Name="Container">
        <!-- 런타임에서 SKGLView(기기) 또는 SKCanvasView(시뮬레이터) 를 추가합니다 -->

        <!-- UI 오버레이 예시 (게임 화면 위에 그려짐) -->
        <!-- 타이머 레이블 (중앙 상단) -->
        <Label x:Name="TimerLabel"
               Text="Timer : 300"
               TextColor="White"
               FontAttributes="Bold"
               FontSize="32"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               Margin="0, 20, 0, 0"
               InputTransparent="True"/>

        <!-- 감옥 현황 레이블 (우측 상단) -->
        <Label x:Name="JailLabel"
               Text="Jail : 0/0"
               TextColor="White"
               FontAttributes="Bold"
               FontSize="16"
               HorizontalOptions="End"
               VerticalOptions="Start"
               Margin="0, 20, 20, 0"
               InputTransparent="True"/>

        <!-- 화면 중앙 메세지 (카운트다운 등) -->
        <Label x:Name="CenterMessageLabel"
               Text=""
               TextColor="White"
               FontAttributes="Bold"
               FontSize="64"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               InputTransparent="True"/>
    </Grid>

</ContentPage>