<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="polrob.Client.Settings"
             BackgroundColor="#050B1D"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Image Source="gamejoin_background.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               InputTransparent="True" />

        <BoxView InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#64020817" Offset="0" />
                    <GradientStop Color="#42020817" Offset="0.45" />
                    <GradientStop Color="#D0020711" Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <ScrollView>
            <VerticalStackLayout Padding="18,104,18,36"
                                 Spacing="18"
                                 MaximumWidthRequest="470"
                                 HorizontalOptions="Center">

                <Border HeightRequest="76"
                        Margin="38,0"
                        Padding="10"
                        BackgroundColor="#102F66"
                        Stroke="#F1D49A"
                        StrokeThickness="4">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#D8000000" Offset="0,8" Radius="10" Opacity="0.85" />
                    </Border.Shadow>
                    <Label Text="게임 설정"
                           FontFamily="OpenSansSemibold"
                           FontAttributes="Bold"
                           FontSize="34"
                           TextColor="#FFF8E8"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center">
                        <Label.Shadow>
                            <Shadow Brush="#CB020816" Offset="0,4" Radius="3" Opacity="1" />
                        </Label.Shadow>
                    </Label>
                </Border>

                <Border Padding="5"
                        BackgroundColor="#17191E"
                        Stroke="#F2D292"
                        StrokeThickness="4">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="32" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#E6000000" Offset="0,12" Radius="14" Opacity="0.9" />
                    </Border.Shadow>

                    <Border Padding="18,22"
                            BackgroundColor="#071A36"
                            Stroke="#344A6B"
                            StrokeThickness="2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="27" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="16">
                            <Label Text="오디오 및 알림"
                                   Margin="4,0,0,0"
                                   FontFamily="OpenSansSemibold"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="#8FCBFF" />

                            <Border Padding="16,15"
                                    BackgroundColor="#10223E"
                                    Stroke="#38537A"
                                    StrokeThickness="2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Label Text="♪"
                                               WidthRequest="34"
                                               FontAttributes="Bold"
                                               FontSize="30"
                                               TextColor="#39B8FF"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                                            <Label Text="소리 크기"
                                                   FontFamily="OpenSansSemibold"
                                                   FontAttributes="Bold"
                                                   FontSize="20"
                                                   TextColor="#FFF8E8" />
                                            <Label Text="팀 음성 재생 볼륨"
                                                   FontSize="13"
                                                   TextColor="#9FB1C9" />
                                        </VerticalStackLayout>
                                        <Label x:Name="VolumeValueLabel"
                                               Grid.Column="2"
                                               Text="100%"
                                               FontFamily="OpenSansSemibold"
                                               FontAttributes="Bold"
                                               FontSize="18"
                                               TextColor="#FFD118"
                                               VerticalTextAlignment="Center" />
                                    </Grid>
                                    <Slider x:Name="SoundVolumeSlider"
                                            Minimum="0"
                                            Maximum="1"
                                            MinimumTrackColor="#19A8FF"
                                            MaximumTrackColor="#263B57"
                                            ThumbColor="#FFD118"
                                            ValueChanged="OnSoundVolumeChanged"
                                            SemanticProperties.Description="소리 크기" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Padding="16,15"
                                    BackgroundColor="#10223E"
                                    Stroke="#38537A"
                                    StrokeThickness="2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Label Text="≋"
                                           WidthRequest="34"
                                           FontAttributes="Bold"
                                           FontSize="31"
                                           TextColor="#39B8FF"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="진동"
                                               FontFamily="OpenSansSemibold"
                                               FontAttributes="Bold"
                                               FontSize="20"
                                               TextColor="#FFF8E8" />
                                        <Label Text="상대가 가까워지면 진동으로 알림"
                                               FontSize="13"
                                               TextColor="#9FB1C9" />
                                    </VerticalStackLayout>
                                    <Switch x:Name="VibrationSwitch"
                                            Grid.Column="2"
                                            OnColor="#148DF5"
                                            ThumbColor="#FFF8E8"
                                            Toggled="OnVibrationToggled"
                                            SemanticProperties.Description="진동 켜기 또는 끄기"
                                            VerticalOptions="Center" />
                                </Grid>
                            </Border>

                            <BoxView HeightRequest="2" Margin="12,2" Color="#284467" />

                            <Label Text="권한"
                                   Margin="4,0,0,0"
                                   FontFamily="OpenSansSemibold"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="#8FCBFF" />

                            <Border Padding="16,15"
                                    BackgroundColor="#0A2349"
                                    Stroke="#385E8F"
                                    StrokeThickness="2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border WidthRequest="38"
                                                HeightRequest="38"
                                                Padding="7"
                                                BackgroundColor="#116DDB"
                                                Stroke="#58CCFF"
                                                StrokeThickness="2"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="19" />
                                            </Border.StrokeShape>
                                            <Path Data="M12,2A3,3 0 0,0 9,5V11A3,3 0 0,0 12,14A3,3 0 0,0 15,11V5A3,3 0 0,0 12,2M7,10V11A5,5 0 0,0 11,15.9V18H8V20H16V18H13V15.9A5,5 0 0,0 17,11V10H15V11A3,3 0 0,1 12,14A3,3 0 0,1 9,11V10H7Z"
                                                  Fill="#FFFDF4"
                                                  Aspect="Uniform" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="마이크 권한"
                                                   FontFamily="OpenSansSemibold"
                                                   FontAttributes="Bold"
                                                   FontSize="20"
                                                   TextColor="#FFF8E8" />
                                            <Label x:Name="MicrophoneStatusLabel"
                                                   Text="확인 중..."
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="14"
                                                   TextColor="#9FB1C9" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Label Text="팀 음성 대화에 사용됩니다. 게임 시작 중에는 권한 창을 표시하지 않습니다."
                                           FontSize="13"
                                           TextColor="#B9C7DB"
                                           LineBreakMode="WordWrap" />

                                    <Button x:Name="MicrophonePermissionButton"
                                            Text="마이크 권한 허용"
                                            HeightRequest="52"
                                            FontFamily="OpenSansSemibold"
                                            FontAttributes="Bold"
                                            FontSize="17"
                                            TextColor="#FFF8E8"
                                            BackgroundColor="#1266CF"
                                            BorderColor="#5CC8FF"
                                            BorderWidth="2"
                                            CornerRadius="15"
                                            Clicked="OnMicrophonePermissionClicked" />
                                </VerticalStackLayout>
                            </Border>

                            <Label Text="설정은 이 기기에 자동으로 저장됩니다."
                                   FontSize="13"
                                   TextColor="#8298B4"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Border WidthRequest="64"
                HeightRequest="64"
                Margin="18,22,0,0"
                Padding="0"
                BackgroundColor="#171A22"
                Stroke="#6D7380"
                StrokeThickness="3"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                ZIndex="10"
                SemanticProperties.Description="뒤로가기">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#CC000000" Offset="0,6" Radius="8" Opacity="0.75" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackClicked" />
            </Border.GestureRecognizers>
            <Border Padding="9"
                    BackgroundColor="#1477E8"
                    Stroke="#55C7FF"
                    StrokeThickness="2">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <Path Data="M20,11H7.83L13.42,5.41L12,4L4,12L12,20L13.42,18.59L7.83,13H20V11Z"
                      Fill="#FFFDF4"
                      Stroke="#17243A"
                      StrokeThickness="0.7"
                      Aspect="Uniform"
                      WidthRequest="42"
                      HeightRequest="42" />
            </Border>
        </Border>
    </Grid>
</ContentPage>
