<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="polrob.Client.GameLobby"
             BackgroundColor="#555555"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, *, Auto"
            Padding="0,20,0,0">

        <!-- Top Left Home Button -->
        <Frame Grid.Row="0"
               HorizontalOptions="Start"
               VerticalOptions="Start"
               Margin="20,0,0,0"
               Padding="12,10"
               BackgroundColor="#76d859"
               CornerRadius="15"
               BorderColor="Transparent"
               HasShadow="False">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnHomeClicked"/>
            </Frame.GestureRecognizers>
            <Path Data="M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z"
                  Fill="Black"
                  Aspect="Uniform"
                  WidthRequest="35"
                  HeightRequest="35"/>
        </Frame>

        <Button x:Name="ProfileButton"
                Grid.Row="0"
                Text=""
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="0,0,20,0"
                CornerRadius="20"
                FontAttributes="Bold"
                FontSize="18"
                TextColor="Black"
                Padding="24,8"
                BackgroundColor="#76d859"
                IsVisible="False"
                Clicked="OnProfileClicked"/>

        <!-- Center Text "Lobby" -->
        <Label Grid.Row="1"
               Text="Lobby"
               FontSize="46"
               FontAttributes="Bold"
               TextColor="White"
               HorizontalOptions="Center"
               Margin="0,30,0,40"/>

        <!-- Two Columns with Vertical Separator -->
        <Grid Grid.Row="2"
                ColumnDefinitions="*, 2, *">
            <!-- Police Area -->
            <Grid Grid.Column="0"
                    BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPoliceAreaTapped"/>
                </Grid.GestureRecognizers>
                <VerticalStackLayout>
                    <Label Text="Police"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           Margin="0,0,0,20"/>

                    <!-- Police Players will be added here -->
                    <VerticalStackLayout x:Name="PoliceList"
                            Spacing="10"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Separator line -->
            <BoxView Grid.Column="1"
                    Color="White"
                    VerticalOptions="Fill"/>

            <!-- Robber Area -->
            <Grid Grid.Column="2"
                    BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRobberAreaTapped"/>
                </Grid.GestureRecognizers>
                <VerticalStackLayout>
                    <Label Text="Robber"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           Margin="0,0,0,20"/>

                    <!-- Robber Players will be added here -->
                    <VerticalStackLayout x:Name="RobberList"
                            Spacing="10"/>
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- Bottom Game Start Button -->
        <Button Grid.Row="3"
                Text="Game Start"
                FontAttributes="Bold"
                FontSize="24"
                TextColor="Black"
                BackgroundColor="#76d859"
                HeightRequest="80"
                CornerRadius="20"
                Margin="30,40,30,40"
                Clicked="OnGameStartClicked"/>
    </Grid>

</ContentPage>
