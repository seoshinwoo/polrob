<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="polrob.Client.Profile"
             BackgroundColor="#050B1D"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Image Source="gamejoin_background.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               InputTransparent="True" />

        <BoxView InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="0,1">
                    <GradientStop Color="#4A020817"
                                  Offset="0" />
                    <GradientStop Color="#27020817"
                                  Offset="0.45" />
                    <GradientStop Color="#C2020711"
                                  Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <ScrollView>
            <VerticalStackLayout Padding="18,104,18,36"
                                 Spacing="18">

                <Grid HeightRequest="116"
                      MaximumWidthRequest="390"
                      HorizontalOptions="Fill">
                    <Image Source="lobby_police_avatar.png"
                           WidthRequest="76"
                           HeightRequest="76"
                           Margin="42,0,0,0"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"
                           Aspect="AspectFit"
                           Opacity="0.9" />
                    <Image Source="lobby_robber_avatar.png"
                           WidthRequest="76"
                           HeightRequest="76"
                           Margin="0,0,42,0"
                           HorizontalOptions="End"
                           VerticalOptions="Start"
                           Aspect="AspectFit"
                           Opacity="0.9" />

                    <Border HeightRequest="76"
                            Margin="38,38,38,0"
                            Padding="10"
                            BackgroundColor="#102F66"
                            Stroke="#F1D49A"
                            StrokeThickness="4"
                            VerticalOptions="End">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#D8000000"
                                    Offset="0,8"
                                    Radius="10"
                                    Opacity="0.85" />
                        </Border.Shadow>
                        <Label Text="내 프로필"
                               FontFamily="OpenSansSemibold"
                               FontAttributes="Bold"
                               FontSize="34"
                               TextColor="#FFF8E8"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center">
                            <Label.Shadow>
                                <Shadow Brush="#CB020816"
                                        Offset="0,4"
                                        Radius="3"
                                        Opacity="1" />
                            </Label.Shadow>
                        </Label>
                    </Border>
                </Grid>

                <Border Padding="5"
                        MaximumWidthRequest="430"
                        BackgroundColor="#17191E"
                        Stroke="#F2D292"
                        StrokeThickness="4"
                        HorizontalOptions="Fill">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="32" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#E6000000"
                                Offset="0,12"
                                Radius="14"
                                Opacity="0.9" />
                    </Border.Shadow>

                    <Border Padding="20,24,20,20"
                            BackgroundColor="#071A36"
                            Stroke="#344A6B"
                            StrokeThickness="2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="27" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="17">
                            <!-- 추후 사용자가 고른 프로필 이미지의 Source만 교체하면 됩니다. -->
                            <Border WidthRequest="118"
                                    HeightRequest="118"
                                    Padding="6"
                                    BackgroundColor="#17191E"
                                    Stroke="#F3D392"
                                    StrokeThickness="4"
                                    HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="59" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#B81589FF"
                                            Offset="0,0"
                                            Radius="12"
                                            Opacity="0.7" />
                                </Border.Shadow>
                                <Border Padding="15"
                                        BackgroundColor="#116DDB"
                                        Stroke="#58CCFF"
                                        StrokeThickness="3">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="52" />
                                    </Border.StrokeShape>
                                    <Image Source="main_login_user.png"
                                           WidthRequest="76"
                                           HeightRequest="76"
                                           Aspect="AspectFit" />
                                </Border>
                            </Border>

                            <Label x:Name="NameLabel"
                                   Text=""
                                   FontFamily="OpenSansSemibold"
                                   FontAttributes="Bold"
                                   FontSize="30"
                                   TextColor="#FFF8E8"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation"
                                   HorizontalTextAlignment="Center">
                                <Label.Shadow>
                                    <Shadow Brush="#D0000000"
                                            Offset="0,3"
                                            Radius="3"
                                            Opacity="1" />
                                </Label.Shadow>
                            </Label>

                            <BoxView HeightRequest="2"
                                     Margin="18,0"
                                     Color="#284467" />

                            <VerticalStackLayout Spacing="7">
                                <Label Text="이름"
                                       Margin="5,0,0,0"
                                       FontFamily="OpenSansSemibold"
                                       FontAttributes="Bold"
                                       FontSize="18"
                                       TextColor="#FFF8E8" />
                                <Border HeightRequest="60"
                                        Padding="4"
                                        BackgroundColor="#030913"
                                        Stroke="#03060C"
                                        StrokeThickness="3">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="17" />
                                    </Border.StrokeShape>
                                    <Border Padding="12,0"
                                            BackgroundColor="#10223E"
                                            Stroke="#38537A"
                                            StrokeThickness="2">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="13" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="30,*"
                                              ColumnSpacing="10">
                                            <Image Source="login_name.png"
                                                   WidthRequest="27"
                                                   HeightRequest="27"
                                                   Aspect="AspectFit"
                                                   VerticalOptions="Center" />
                                            <Label x:Name="NameValueLabel"
                                                   Grid.Column="1"
                                                   FontFamily="OpenSansSemibold"
                                                   FontAttributes="Bold"
                                                   FontSize="18"
                                                   TextColor="#FFF8E8"
                                                   MaxLines="1"
                                                   LineBreakMode="TailTruncation"
                                                   VerticalTextAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="7">
                                <Label Text="사용자 ID"
                                       Margin="5,0,0,0"
                                       FontFamily="OpenSansSemibold"
                                       FontAttributes="Bold"
                                       FontSize="18"
                                       TextColor="#FFF8E8" />
                                <Border HeightRequest="60"
                                        Padding="4"
                                        BackgroundColor="#030913"
                                        Stroke="#03060C"
                                        StrokeThickness="3">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="17" />
                                    </Border.StrokeShape>
                                    <Border Padding="12,0"
                                            BackgroundColor="#10223E"
                                            Stroke="#38537A"
                                            StrokeThickness="2">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="13" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="30,*"
                                              ColumnSpacing="10">
                                            <Label Text="#"
                                                   FontFamily="OpenSansSemibold"
                                                   FontAttributes="Bold"
                                                   FontSize="27"
                                                   TextColor="#39B8FF"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center" />
                                            <Label x:Name="UserIdLabel"
                                                   Grid.Column="1"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="16"
                                                   TextColor="#B9C7DB"
                                                   MaxLines="1"
                                                   LineBreakMode="MiddleTruncation"
                                                   VerticalTextAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Border>
                            </VerticalStackLayout>

                            <Border Padding="4"
                                    Margin="0,4,0,0"
                                    BackgroundColor="#030913"
                                    Stroke="#F2D292"
                                    StrokeThickness="3">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22" />
                                </Border.StrokeShape>
                                <Border Padding="14,14,14,12"
                                        BackgroundColor="#0A2349"
                                        Stroke="#385E8F"
                                        StrokeThickness="2">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                              ColumnSpacing="10">
                                            <Label Text="게임 전적"
                                                   FontFamily="OpenSansSemibold"
                                                   FontAttributes="Bold"
                                                   FontSize="22"
                                                   TextColor="#FFF8E8"
                                                   VerticalTextAlignment="Center" />
                                            <Button x:Name="StatsRefreshButton"
                                                    Grid.Column="1"
                                                    Text="새로고침"
                                                    Padding="10,4"
                                                    FontFamily="OpenSansSemibold"
                                                    FontSize="12"
                                                    TextColor="#DCEBFF"
                                                    BackgroundColor="#173C6C"
                                                    BorderColor="#3975AD"
                                                    BorderWidth="1"
                                                    CornerRadius="10"
                                                    Clicked="OnStatsRefreshClicked"
                                                    VerticalOptions="Center" />
                                            <ActivityIndicator x:Name="StatsLoadingIndicator"
                                                               Grid.Column="2"
                                                               WidthRequest="24"
                                                               HeightRequest="24"
                                                               Color="#39B8FF"
                                                               IsRunning="False"
                                                               IsVisible="False"
                                                               VerticalOptions="Center" />
                                        </Grid>

                                        <Label x:Name="StatsStatusLabel"
                                               Text="전적을 불러오는 중..."
                                               FontFamily="OpenSansSemibold"
                                               FontSize="14"
                                               TextColor="#B9C7DB"
                                               HorizontalTextAlignment="Center"
                                               IsVisible="False" />

                                        <Grid x:Name="StatsGrid"
                                              RowDefinitions="62,1,62,1,62"
                                              ColumnDefinitions="46,*,Auto"
                                              ColumnSpacing="9"
                                              IsVisible="False">
                                            <Label Text="★"
                                                   FontSize="27"
                                                   TextColor="#FFD118"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center" />
                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="1"
                                                                 VerticalOptions="Center">
                                                <Label Text="전체"
                                                       FontFamily="OpenSansSemibold"
                                                       FontAttributes="Bold"
                                                       FontSize="17"
                                                       TextColor="#FFF8E8" />
                                                <Label x:Name="OverallRecordLabel"
                                                       Text="0전 0승 0패"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="14"
                                                       TextColor="#B9C7DB" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2"
                                                                 Spacing="0"
                                                                 VerticalOptions="Center">
                                                <Label Text="승률"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="12"
                                                       TextColor="#8FA6C2"
                                                       HorizontalTextAlignment="End" />
                                                <Label x:Name="OverallWinRateLabel"
                                                       Text="0%"
                                                       FontFamily="OpenSansSemibold"
                                                       FontAttributes="Bold"
                                                       FontSize="20"
                                                       TextColor="#FFD118"
                                                       HorizontalTextAlignment="End" />
                                            </VerticalStackLayout>

                                            <BoxView Grid.Row="1"
                                                     Grid.ColumnSpan="3"
                                                     Color="#285285" />

                                            <Image Grid.Row="2"
                                                   Source="lobby_police_avatar.png"
                                                   WidthRequest="40"
                                                   HeightRequest="40"
                                                   Aspect="AspectFit"
                                                   VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Row="2"
                                                                 Grid.Column="1"
                                                                 Spacing="1"
                                                                 VerticalOptions="Center">
                                                <Label Text="경찰"
                                                       FontFamily="OpenSansSemibold"
                                                       FontAttributes="Bold"
                                                       FontSize="17"
                                                       TextColor="#62C7FF" />
                                                <Label x:Name="PoliceRecordLabel"
                                                       Text="0전 0승 0패"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="14"
                                                       TextColor="#B9C7DB" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Row="2"
                                                                 Grid.Column="2"
                                                                 Spacing="0"
                                                                 VerticalOptions="Center">
                                                <Label Text="승률"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="12"
                                                       TextColor="#8FA6C2"
                                                       HorizontalTextAlignment="End" />
                                                <Label x:Name="PoliceWinRateLabel"
                                                       Text="0%"
                                                       FontFamily="OpenSansSemibold"
                                                       FontAttributes="Bold"
                                                       FontSize="20"
                                                       TextColor="#62C7FF"
                                                       HorizontalTextAlignment="End" />
                                            </VerticalStackLayout>

                                            <BoxView Grid.Row="3"
                                                     Grid.ColumnSpan="3"
                                                     Color="#285285" />

                                            <Image Grid.Row="4"
                                                   Source="lobby_robber_avatar.png"
                                                   WidthRequest="40"
                                                   HeightRequest="40"
                                                   Aspect="AspectFit"
                                                   VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Row="4"
                                                                 Grid.Column="1"
                                                                 Spacing="1"
                                                                 VerticalOptions="Center">
                                                <Label Text="도둑"
                                                       FontFamily="OpenSansSemibold"
                                                       FontAttributes="Bold"
                                                       FontSize="17"
                                                       TextColor="#FF9A49" />
                                                <Label x:Name="RobberRecordLabel"
                                                       Text="0전 0승 0패"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="14"
                                                       TextColor="#B9C7DB" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Row="4"
                                                                 Grid.Column="2"
                                                                 Spacing="0"
                                                                 VerticalOptions="Center">
                                                <Label Text="승률"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="12"
                                                       TextColor="#8FA6C2"
                                                       HorizontalTextAlignment="End" />
                                                <Label x:Name="RobberWinRateLabel"
                                                       Text="0%"
                                                       FontFamily="OpenSansSemibold"
                                                       FontAttributes="Bold"
                                                       FontSize="20"
                                                       TextColor="#FF9A49"
                                                       HorizontalTextAlignment="End" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </Border>

                            <Border HeightRequest="72"
                                    Margin="5,7,5,0"
                                    Padding="5"
                                    BackgroundColor="#17120E"
                                    Stroke="#F4D89D"
                                    StrokeThickness="4">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#D8000000"
                                            Offset="0,7"
                                            Radius="8"
                                            Opacity="0.85" />
                                </Border.Shadow>
                                <Button Text="로그아웃"
                                        FontFamily="OpenSansSemibold"
                                        FontAttributes="Bold"
                                        FontSize="27"
                                        TextColor="#FFF8E8"
                                        BorderColor="#FF9A49"
                                        BorderWidth="2"
                                        CornerRadius="17"
                                        Padding="8,0"
                                        Clicked="OnLogoutClicked">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0"
                                                             EndPoint="0,1">
                                            <GradientStop Color="#F05A27"
                                                          Offset="0" />
                                            <GradientStop Color="#9D240B"
                                                          Offset="1" />
                                        </LinearGradientBrush>
                                    </Button.Background>
                                </Button>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Border WidthRequest="64"
                HeightRequest="64"
                Margin="18,22,0,0"
                Padding="0"
                BackgroundColor="#171A22"
                Stroke="#6D7380"
                StrokeThickness="3"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                ZIndex="10"
                SemanticProperties.Description="뒤로가기">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#CC000000"
                        Offset="0,6"
                        Radius="8"
                        Opacity="0.75" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackClicked" />
            </Border.GestureRecognizers>
            <Border Padding="9"
                    BackgroundColor="#1477E8"
                    Stroke="#55C7FF"
                    StrokeThickness="2">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <Path Data="M20,11H7.83L13.42,5.41L12,4L4,12L12,20L13.42,18.59L7.83,13H20V11Z"
                      Fill="#FFFDF4"
                      Stroke="#17243A"
                      StrokeThickness="0.7"
                      Aspect="Uniform"
                      WidthRequest="42"
                      HeightRequest="42" />
            </Border>
        </Border>
    </Grid>
</ContentPage>
