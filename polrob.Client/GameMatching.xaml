<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="polrob.Client.GameMatching"
             BackgroundColor="#555555"
             Shell.NavBarIsVisible="False">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <VerticalStackLayout Grid.Row="0"
                             Spacing="28"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">
            <ActivityIndicator x:Name="MatchingActivityIndicator"
                               IsRunning="True"
                               Color="#76d859"
                               WidthRequest="72"
                               HeightRequest="72"/>

            <Label x:Name="MatchingStatusLabel"
                   Text="매칭 중(0/6)"
                   FontSize="36"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>

        <Button Grid.Row="1"
                Text="매칭 취소"
                FontSize="14"
                FontAttributes="Bold"
                TextColor="Black"
                BackgroundColor="#f9d955"
                WidthRequest="120"
                HeightRequest="44"
                CornerRadius="14"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,24"
                Clicked="OnCancelMatchingClicked"/>
    </Grid>

</ContentPage>
